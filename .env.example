# ==============================================================================
# HUMANIZER AI — CONFIGURATION & API KEYS
# ==============================================================================
# Anda dapat mengisi salah satu atau beberapa API Key di bawah ini.
# Sistem secara otomatis memilih AI engine terbaik yang tersedia (Groq / Gemini / OpenAI).
# Jika semua API Key kosong, sistem akan menggunakan Intelligent Built-in Heuristic Engine
# sehingga aplikasi tetap dapat dicoba secara lokal tanpa kendala!
# ==============================================================================

# 1. Google Gemini API (Sangat Direkomendasikan: Cepat & Kuota Gratis Besar)
# Dapatkan API Key gratis di: https://aistudio.google.com/
GEMINI_API_KEY=

# 2. Groq Cloud API (Rekomendasi untuk Llama 3.3 70B: Inferensi Kilat ~250 token/detik)
# Dapatkan API Key gratis di: https://console.groq.com/
GROQ_API_KEY=

# 3. OpenAI API (Opsional: GPT-4o-mini / GPT-4o)
# Dapatkan API Key di: https://platform.openai.com/api-keys
OPENAI_API_KEY=

# Model default yang dipilih (pilihan: "auto", "gemini", "groq", "openai")
DEFAULT_AI_PROVIDER=auto

# Batasan Kata Per Permintaan (Word Limit: 1 - 1000 kata)
NEXT_PUBLIC_WORD_LIMIT_MIN=1
NEXT_PUBLIC_WORD_LIMIT_MAX=1000

# Rate Limiting (Maksimal request per menit per IP untuk keamanan)
RATE_LIMIT_MAX_REQUESTS=20
RATE_LIMIT_WINDOW_SECONDS=60

# NextAuth / Session Secret (Dapat diisi sembarang string acak untuk produksi)
SESSION_SECRET=humanizer-ai-ultra-stealth-secret-key-2026
